# demo: data contoh tersimpan di .data/demo.json; supabase: database sebenarnya.
DATA_MODE=demo
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Untuk QR meja: alamat yang dapat diakses ponsel, misalnya http://192.168.1.10:5173
PUBLIC_APP_URL=http://localhost:5173
# Kata sandi akun demo dibaca ketika backend dijalankan.
DEMO_OWNER_PASSWORD=TerasOwner2026!
DEMO_CASHIER_PASSWORD=TerasKasir2026!
# Digunakan hanya ketika DATA_MODE=supabase. JANGAN gunakan awalan VITE_ untuk secret ini.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Isi dengan publishable key (sb_publishable_...) atau legacy anon key.
SUPABASE_PUBLISHABLE_KEY=
# Informasi asli cafe belum diberikan; kosongkan agar UI memberi keterangan belum tersedia.
CAFE_ADDRESS=
CAFE_MAP_EMBED_URL=
CAFE_MAP_URL=
CAFE_WHATSAPP=
CAFE_INSTAGRAM_URL=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_HOLDER=
PAYMENT_QRIS_IMAGE_URL=
